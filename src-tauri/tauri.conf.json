{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TuneLib",
  "version": "1.0.0",
  "identifier": "com.tunelib.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "visible": false,
        "title": "TuneLib",
        "width": 1280,
        "height": 820,
        "minWidth": 780,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: cover: http://cover.localhost; media-src 'self' track: http://track.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "category": "Music",
    "shortDescription": "Audio library manager",
    "fileAssociations": [
      {
        "ext": ["mp3", "flac", "m4a", "ogg", "wav"],
        "name": "Audio File",
        "description": "Audio file",
        "role": "Viewer",
        "mimeType": "audio/*"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["Italian", "English", "French", "Spanish", "German"],
        "customLanguageFiles": {
          "Italian": "nsis/Italian.nsh",
          "German": "nsis/German.nsh",
          "Spanish": "nsis/Spanish.nsh",
          "French": "nsis/French.nsh"
        }
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
