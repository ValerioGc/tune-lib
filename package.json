{
  "name": "tuneLib",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Audio library manager with metadata editing, multiple views and an integrated player.",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "build:app": "tauri build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-cucumber.cjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:pages": "node scripts/build-pages.cjs",
    "check:pages": "node scripts/build-pages.cjs --check",
    "test:sonar": "npm run test:coverage && npm run coverage:rust && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --message-format=json > src-tauri/clippy-report.json && docker run --rm -e SONAR_TOKEN -e SONAR_HOST_URL=http://host.docker.internal:9000 -v \"%cd%:/usr/src\" sonarsource/sonar-scanner-cli",
    "coverage:rust": "node -e \"require('fs').mkdirSync('src-tauri/coverage',{recursive:true})\" && cargo llvm-cov --manifest-path src-tauri/Cargo.toml --ignore-filename-regex \"(main|lib)\\.rs$\" --fail-under-functions 80 --lcov --output-path src-tauri/coverage/lcov.info",
    "coverage:rust:summary": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --ignore-filename-regex \"(main|lib)\\.rs$\" --summary-only",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "verify:rust": "npm run format:rust:check && npm run lint:rust && node scripts/check-capabilities.cjs && npm run coverage:rust",
    "verify:all": "npm run verify && npm run verify:rust",
    "docker:sonar:up": "docker compose -f ./docker-compose.sonar.yml up -d",
    "docker:sonar:down": "docker compose -f ./docker-compose.sonar.yml down",
    "docker:sonar:logs": "docker compose -f ./docker-compose.sonar.yml logs -f sonarqube",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-autostart": "^2.6.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "cssnano": "^9.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-combine-duplicated-selectors": "^10.0.3",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "@parcel/watcher": false
  }
}
